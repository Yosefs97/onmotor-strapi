{
  "kind": "collectionType",
  "collectionName": "forum_categories",
  "info": {
    "singularName": "forum-category",
    "pluralName": "forum-categories",
    "displayName": "Forum Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string"
    },
    "forum_threads": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::forum-thread.forum-thread",
      "mappedBy": "category"
    }
  }
}
