{
  "kind": "collectionType",
  "collectionName": "forum_threads",
  "info": {
    "singularName": "forum-thread",
    "pluralName": "forum-threads",
    "displayName": "Forum Thread"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "blocks"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "datetime",
      "default": "2025-10-18T21:00:00.000Z"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::forum-category.forum-category",
      "inversedBy": "forum_threads"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::forum-comment.forum-comment",
      "mappedBy": "forum_thread"
    }
  }
}
