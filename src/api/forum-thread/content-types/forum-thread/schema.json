{
  "kind": "collectionType",
  "collectionName": "forum_threads",
  "info": {
    "singularName": "forum-thread",
    "pluralName": "forum-threads",
    "displayName": "Forum Thread"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "content": { "type": "text" },
    "author": { "type": "string" },
    "date": { "type": "datetime", "default": "now" },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::forum-category.forum-category",
      "inversedBy": "threads"
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::forum-comment.forum-comment",
      "mappedBy": "thread"
    }
  }
}
